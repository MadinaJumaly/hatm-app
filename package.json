{
  "name": "hatm",
  "version": "0.1.0",
  "private": true,
  "description": "Group hatm al-Quran website (Kazakh)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "wrangler types --env-file /dev/null",
    "dev": "vite",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "build:prod": "CLOUDFLARE_ENV=production vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/check-size.ts",
    "check:unicode": "node scripts/check-unicode.ts",
    "check": "npm run check:unicode && npm run lint && npm run format:check && npm run typecheck && npm test",
    "cf-typegen": "wrangler types --env-file /dev/null",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.jsonc",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging -c wrangler.jsonc",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production -c wrangler.jsonc",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "deploy:prod": "npm run build:prod && wrangler deploy",
    "seed": "node scripts/seed-khatm.ts",
    "hash-password": "node scripts/hash-password.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "hono": "^4.13.13",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@eslint/js": "^10.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "axe-core": "~4.13.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "~4.1.12",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents": false,
    "workerd@1.20261012.1": true
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7",
    "serialize-javascript": "7.1.3"
  }
}
